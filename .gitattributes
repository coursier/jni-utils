# The C sources and headers use CRLF line endings. "text=auto" rather than "text",
# so that the files already committed with CRLF aren't flagged for renormalization.
*.c text=auto eol=crlf
*.h text=auto eol=crlf

# The NativeApi implementations generated by the build and checked in, which
# './mill __.checkNativeApi' compares to what the build generates, with LF line endings
windows-jni-utils-bootstrap/src/main/java/coursier/bootstrap/launcher/jniutils/BootstrapNativeApi.java text eol=lf
windows-jni-utils-lmcoursier/src/main/java/lmcoursier/internal/jniutils/LmNativeApi.java text eol=lf
windows-jni-utils-coursierapi/src/main/java/coursierapi/internal/jniutils/ApiInternalNativeApi.java text eol=lf
